{
  "name": "dsh-wallpaper-bg",
  "version": "0.5.9",
  "description": "DeepSeek Harness（dsh web 网页界面与 0.2 桌面端）独立壁纸背景插件：内置壁纸 / 自定义上传 / Wallpaper Engine 壁纸库（只读）三种来源，支持图片、视频、网页与场景工坊预览图，含遮罩·模糊·亮度·安全放大调节。WE 壁纸库来源需仓库内的 wallpaper-engine-api 服务（不在 npm 包内，插件面板会给出提示）。",
  "type": "module",
  "main": "lib/host.js",
  "bin": {
    "dsh-wallpaper-bg": "bin/dsh-wallpaper-bg.js"
  },
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/host.js",
    "lib/client.js",
    "bin/dsh-wallpaper-bg.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/screenshots"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "desktop",
    "wallpaper",
    "wallpaper-engine",
    "cordis",
    "plugin"
  ],
  "license": "MIT",
  "author": "nishuoyang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nishuoyang/dsh-wallpaper-bg.git"
  },
  "homepage": "https://github.com/nishuoyang/dsh-wallpaper-bg#readme",
  "bugs": {
    "url": "https://github.com/nishuoyang/dsh-wallpaper-bg/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
